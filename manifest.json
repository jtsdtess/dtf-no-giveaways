{
  "manifest_version": 3,
  "name": "DTF Фильтр слов",
  "version": "1.0",
  "description": "Скрывает посты с определенными словами на DTF.ru",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://dtf.ru/*", "https://*.dtf.ru/*"],
  "content_scripts": [
    {
      "matches": ["https://dtf.ru/*", "https://*.dtf.ru/*"],
      "js": ["src/content/presets.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "DTF Фильтр слов",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
